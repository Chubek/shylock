extern fn shy_latex_begin(title:string)->i64;
extern fn shy_latex_append(level:i64,text:string)->i64;
extern fn shy_latex_finish()->i64;
extern fn shy_latex_digest()->string;
extern fn shy_latex_publish()->i64;
extern fn shy_latex_close()->i64;

# Copy template strings into managed On1x values before releasing the JSON owner.
fn report_template(path:string)->(i64,string,string,sexpr) {
  if shy_document_open(path)!=1 { return (shy_error("cannot read report template JSON"),"","",sx_nil()); }
  var result=0;
  var blocks=sx_nil();
  var title="";
  var identity="";
  if !@fields("closed","",-1,"schema:string","title:string","blocks:array") ||
     shy_document_text("",-1,"schema")!="shylock.report-template/v1" {
    result=shy_error("invalid report template schema or fields");
  } else {
    title=text_concat("",shy_document_text("",-1,"title"));
    identity=text_concat("",shy_document_id());
    let count=shy_document_size("",-1,"blocks");
    if title=="" || text_len(title)>8192 || identity=="" || count<1 || count>128 {
      result=shy_error("report template needs a title and 1..128 blocks");
    }
    var i=0;
    while result==0 && i<count {
      let kind=shy_document_text("blocks",i,"kind");
      var level=0;
      var valid=false;
      if kind=="paragraph" {
        valid=@fields("closed","blocks",i,"kind:string","text:string");
      } else { if kind=="section" {
        valid=@fields("closed","blocks",i,"kind:string","text:string","level:integer");
        level=shy_document_number("blocks",i,"level");
        valid=valid && level>=1 && level<=3;
      } }
      let text=shy_document_text("blocks",i,"text");
      if !valid || text_len(text)>8192 {
        result=shy_error("report blocks need bounded text and a paragraph or section at level 1..3");
      } else {
        let block=sx_cons(sx_string(SX.sexpr_nat(level)),sx_cons(sx_string(text),sx_nil()));
        blocks=List.basis_list_cons(block,blocks);
      }
      i=i+1;
    }
  }
  shy_document_close();
  return (result,title,identity,List.basis_list_rev(blocks));
}

# RFC 6901 token decoding and traversal policy are On1x, not hidden in C.
fn report_token(text:string)->(bool,string) {
  let out=buffer_new();
  var i=0;
  while i<text_len(text) {
    var byte=text_byte(text,i);
    if byte==126 {
      i=i+1;
      if i==text_len(text) { return (false,""); }
      byte=text_byte(text,i);
      if byte==48 { byte=126; }
      else { if byte==49 { byte=47; } else { return (false,""); } }
    }
    buffer_byte(out,byte); i=i+1;
  }
  return (true,buffer_text(out));
}

fn report_lookup(pointer:string)->(bool,string) {
  if text_len(pointer)<1 || text_len(pointer)>1024 || text_byte(pointer,0)!=47 { return (false,""); }
  shy_document_reset();
  var start=1;
  var running=true;
  while running {
    var end=start;
    while end<text_len(pointer) && text_byte(pointer,end)!=47 { end=end+1; }
    let (decoded,key)=report_token(text_slice(pointer,start,end));
    if !decoded { return (false,""); }
    if shy_document_has("",-1,"","object")==1 {
      if shy_document_child(key)!=1 { return (false,""); }
    } else {
      if shy_document_has("",-1,"","array")!=1 || key=="" || text_len(key)>7 { return (false,""); }
      if text_len(key)>1 && text_byte(key,0)==48 { return (false,""); }
      var i=0;
      while i<text_len(key) {
        if text_byte(key,i)<48 || text_byte(key,i)>57 { return (false,""); }
        i=i+1;
      }
      if shy_document_index(parse_int(key))!=1 { return (false,""); }
    }
    if end==text_len(pointer) { running=false; }
    else { start=end+1; }
  }
  if shy_document_has("",-1,"","string")==1 {
    let value=shy_document_text("",-1,"");
    if text_len(value)>8192 { return (false,""); }
    return (true,text_concat("",value));
  }
  if shy_document_has("",-1,"","object")==1 || shy_document_has("",-1,"","array")==1 { return (false,""); }
  if shy_document_has("",-1,"","number")!=1 && shy_document_has("",-1,"","boolean")!=1 &&
     shy_document_has("",-1,"","null")!=1 { return (false,""); }
  let value=shy_document_json();
  if value=="" || text_len(value)>8192 { return (false,""); }
  return (true,text_concat("",value));
}

fn report_expand(text:string,data_id:string,template_id:string)->(bool,string) {
  let out=buffer_new();
  var i=0;
  var substitutions=0;
  while i<text_len(text) {
    if i+1<text_len(text) && text_byte(text,i)==123 && text_byte(text,i+1)==123 {
      var end=i+2;
      while end+1<text_len(text) && !(text_byte(text,end)==125 && text_byte(text,end+1)==125) { end=end+1; }
      if end+1>=text_len(text) || substitutions>=256 { return (false,""); }
      let pointer=text_slice(text,i+2,end);
      var value="";
      if pointer=="$data_id" { value=data_id; }
      else { if pointer=="$template_id" { value=template_id; }
      else {
        let (found,field)=report_lookup(pointer);
        if !found { return (false,""); }
        value=field;
      } }
      if buffer_len(out)+text_len(value)>65536 { return (false,""); }
      # Inserted values are literal text; never expand their contents again.
      buffer_append(out,value);
      substitutions=substitutions+1; i=end+2;
    } else {
      if buffer_len(out)>=65536 { return (false,""); }
      buffer_byte(out,text_byte(text,i)); i=i+1;
    }
  }
  return (true,buffer_text(out));
}

fn print_report(template:string,data:string)->i64 {
  let (loaded,title,template_id,blocks)=report_template(template);
  if loaded!=0 { return loaded; }
  if shy_document_open(data)!=1 { return shy_error("cannot read report data JSON"); }
  let data_id=text_concat("",shy_document_id());
  let (expanded,heading)=report_expand(title,data_id,template_id);
  var result=0;
  if data_id=="" || !expanded || text_len(heading)>8192 || shy_latex_begin(heading)!=1 {
    result=shy_error("cannot expand report title or initialize MuLIB LaTeX");
  }
  var rest=blocks;
  while result==0 && sx_kind(rest)==3 {
    let block=sx_head(rest);
    let level=parse_int(sx_text(sx_head(block)));
    let (ok,text)=report_expand(sx_text(SX.sexpr_nth(block,1)),data_id,template_id);
    if !ok { result=shy_error("invalid, missing, oversized or non-scalar report placeholder"); }
    else { if shy_latex_append(level,text)!=1 { result=shy_error("MuLIB LaTeX rejected report text or output limit"); } }
    rest=sx_tail(rest);
  }
  if result==0 && shy_latex_finish()!=1 { result=shy_error("cannot finish MuLIB LaTeX report"); }
  if result==0 {
    let audit=buffer_new();
    buffer_append(audit,"{\"schema\":\"shylock.report/v1\",\"format\":\"latex\",");
    demand_member!(audit,"data_id",data_id);
    demand_member!(audit,"template_id",template_id);
    demand_member!(audit,"latex_blake3",shy_latex_digest());
    buffer_append(audit,"\"blocks\":"); buffer_append(audit,SX.sexpr_nat(List.basis_list_length(blocks))); buffer_byte(audit,125);
    result=shy_latex_publish();
    if result==0 { shy_extensions_enqueue_json("report.created",buffer_text(audit)); }
  }
  shy_latex_close(); shy_document_close();
  return result;
}
