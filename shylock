#!/bin/sh
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
export SHY_ROOT="$root"
export SHY_COMMAND="${1:-help}"
if [ "$#" -gt 0 ]; then shift; fi
if [ "$#" -gt 8 ]; then echo "Too many arguments" >&2; exit 2; fi
export SHY_COUNT="$#"
export SHY_1="${1-}" SHY_2="${2-}" SHY_3="${3-}" SHY_4="${4-}"
export SHY_5="${5-}" SHY_6="${6-}" SHY_7="${7-}" SHY_8="${8-}"
exec "${SHY_BINARY:-$root/build/shylock}"
