{
  "schema": "shylock.daemon/v1",
  "provider": "google",
  "query": "lake cottage nightly price",
  "limit": 10,
  "interval_seconds": 3600,
  "allow_network": false,
  "capture": "../../tests/fixtures/google.html",
  "output": "../../dragnet-runs",
