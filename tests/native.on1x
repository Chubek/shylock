extern fn shy_native_registry_test()->i64;
extern fn shy_native_storage_test()->i64;
extern fn shy_native_gui_test()->i64;
extern fn shy_native_document_test()->i64;
extern fn shy_native_latex_test()->i64;
extern fn shy_native_engine_test()->i64;
extern fn shy_native_dragnet_test()->i64;
extern fn shy_native_intelligence_test()->i64;
extern fn shy_formula(path:string,reference:i64,weekend:i64,premium:i64)->i64;

fn main()->i64 {
  if shy_native_naive_test()!=1 { println("native NaiveFinder failed"); return 1; }
  if !naive_policy_test() { println("On1x NaiveFinder policy failed"); return 1; }
  if shy_native_registry_test()!=1 { return 1; }
  if shy_native_storage_test()!=1 { return 1; }
  if shy_native_gui_test()<0 { return 1; }
  if shy_native_document_test()!=1 { return 1; }
  if shy_native_latex_test()!=1 { return 1; }
  if shy_native_engine_test()!=1 { return 1; }
  if shy_native_dragnet_test()!=1 { return 1; }
  if shy_native_intelligence_test()!=1 { return 1; }
  # Two evaluations in the SAME process must not retain formula globals.
  if shy_formula("tests/fixtures/fresh.lua",10000,0,0)!=10001 { return 1; }
  if shy_formula("tests/fixtures/fresh.lua",10000,0,0)!=10001 { return 1; }
  println("Native registry, migration, document-session and formula lifetime tests passed.");
  return 0;
}
import "naive_policy.on1x";
extern fn shy_native_naive_test()->i64;
